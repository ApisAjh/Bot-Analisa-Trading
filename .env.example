# === Wajib ===

# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Pilih salah satu: gemini | openai | claude
AI_PROVIDER=gemini

# API key sesuai provider yang dipilih di AI_PROVIDER
# - gemini -> Google AI Studio API key
# - openai -> OpenAI API key
# - claude -> Anthropic API key
AI_API_KEY=your-ai-vision-api-key


# === Opsional ===

# API key untuk Twelve Data (dipakai oleh /analyze untuk pair Forex/Stock).
# Untuk pair crypto (mis. BTCUSDT), bot otomatis pakai Binance public API
# yang tidak butuh key. Jika MARKET_API_KEY kosong, /analyze tetap jalan
# tapi hanya bisa ambil data untuk pair crypto.
MARKET_API_KEY=your-twelvedata-api-key

# Secret token untuk validasi webhook Telegram (disarankan diisi di production).
# Nilainya bebas (string acak), lalu dipasang juga saat setWebhook via
# parameter secret_token.
TELEGRAM_WEBHOOK_SECRET=isi-dengan-string-acak-yang-sulit-ditebak

# Override nama model default per provider (opsional).
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-sonnet-4-5
